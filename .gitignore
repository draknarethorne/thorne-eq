# Build output
build/
out/
bin/
*.obj
*.pdb
*.ilk
*.exe
*.lib
*.dll

# CMake
CMakeCache.txt
CMakeFiles/
cmake-build-*/

# Visual Studio
.vs/
*.user
*.suo

# Local server config & secrets (never commit)
eqemu_config.json
login.json
*.local.json
*.env

# Python venv (tooling)
.venv/
__pycache__/

# OS noise
Thumbs.db
.DS_Store

# Vendored server/quests source (tracked in their own forked repos, not here)
server/
quests/
maps/

# Local runtime engines (never commit binaries/DB data)
mariadb/

# Disposable local working dirs
.tmp/
.reports/

# --- Intentionally TRACKED (the from-scratch rebuild recipe) ---
# .bin/          tooling scripts (NOT matched by 'bin/' build-output rule above)
# config/        sanitized config templates (real eqemu_config.json/login.json stay ignored)
# db/bootstrap/  custom SQL to rebuild launcher/users/etc. on a fresh DB
