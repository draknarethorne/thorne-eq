{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.git": false
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.venv": true
    },
    "editor.formatOnSave": true,
    "editor.rulers": [100]
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.cpptools",
      "ms-vscode.cmake-tools",
      "ms-python.python",
      "GitHub.copilot",
      "GitHub.copilot-chat"
    ]
  }
}
